{
  "name": "texflow-erp",
  "private": true,
  "version": "6.0.0",
  "description": "TexFlow ERP v6 \u2014 ERPNext-Style Platform Edition",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build-win": "npm run build && electron-builder --win --x64",
    "electron:build-mac": "npm run build && electron-builder --mac --universal",
    "build-win": "npm run electron:build-win",
    "build-mac": "npm run electron:build-mac"
  },
  "build": {
    "appId": "com.ravitextile.erp",
    "productName": "Ravi-Textile ERP",
    "copyright": "Copyright \u00a9 2024 Ravi Textile",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ravi-Textile ERP"
    }
  },
  "dependencies": {
    "@google/genai": "^1.47.0",
    "adm-zip": "^0.5.17",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.561.0",
    "motion": "^12.38.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.2.0",
    "vite": "^7.2.7",
    "wait-on": "^7.2.0"
  }
}